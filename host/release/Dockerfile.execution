FROM node:22-alpine
WORKDIR /app
COPY deploy/execution-gateway.mjs deploy/execution-tailcat.mjs deploy/
COPY clients/shared/ clients/shared/
COPY bin/grokbot-tailcat /app/bin/grokbot-tailcat
COPY network/TAILCAT-LICENSE /app/bin/TAILCAT-LICENSE
COPY THIRD_PARTY/ /app/THIRD_PARTY/
ENV GROKBOT_TAILCAT_BINARY=/app/bin/grokbot-tailcat
RUN mkdir /data && chown node:node /data
COPY server/proxy.mjs server/security.mjs server/storage.mjs server/
USER node
VOLUME ["/data"]
EXPOSE 8443
ENTRYPOINT ["node", "/app/deploy/execution-gateway.mjs"]
